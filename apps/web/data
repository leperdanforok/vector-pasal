export interface Topic {
  slug: string;
  title: string;
  description: string;
  icon: string;
  questions: { question: string; lawRef?: string; pasal?: string }[];
}

export const TOPICS: Topic[] = [
  {
    slug: "ketenagakerjaan",
    title: "Ketenagakerjaan",
    description: "Hak pekerja, upah minimum, dan aturan kerja.",
    icon: "briefcase",
    questions: [
      { question: "Berapa upah minimum?", lawRef: "UU 6/2023" }
    ]
  }
];

export function getTopicBySlug(slug: string) {
  return TOPICS.find((t) => t.slug === slug);
}